---
import "../styles/global.css";

import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title?: string;
}

const { title = "Cookbook" } = Astro.props;
---

<html lang="en">

<head>

<title>{title}</title>

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#a5663f" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="Cookbook" />

<link rel="manifest" href="/manifest.json" />
<link rel="apple-touch-icon" href="/favicon.svg" />

<!-- Runs before first paint: dark mode + hide page until auth check completes -->
<script is:inline>
  (function () {
    var s = localStorage.getItem("cookbook-theme");
    var dark = s ? s === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
    document.documentElement.classList.toggle("dark", dark);
    document.documentElement.style.visibility = "hidden";
  })();
</script>

</head>

<body>

<!-- ── Password gate (full-screen, shown when not authenticated) ────────── -->
<div id="site-gate" style="display:none"
  class="fixed inset-0 z-[999] items-center justify-center bg-[var(--color-bg)] p-4">
  <div class="w-full max-w-sm space-y-6 text-center">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--color-primary)] text-3xl text-white">
      🔒
    </div>
    <div>
      <h1 class="text-3xl">Family Cookbook</h1>
      <p class="mt-2 text-[var(--color-text-muted)]">Enter the password to continue</p>
    </div>
    <div class="space-y-3">
      <input id="gate-input" type="password" autocomplete="current-password"
        class="w-full rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 text-center text-lg outline-none transition focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)]/20"
        placeholder="Password" />
      <p id="gate-error" style="display:none" class="text-sm text-[var(--color-danger)]">Incorrect password — try again.</p>
      <button id="gate-submit"
        class="w-full rounded-full bg-[var(--color-primary)] py-3 text-sm font-medium text-white transition hover:bg-[var(--color-primary-hover)] active:scale-95">
        Unlock
      </button>
    </div>
  </div>
</div>

<!-- ── Site content (hidden until authenticated) ─────────────────────────── -->
<div id="site-content" style="display:none">

<Navbar />

<main>
<slot />
</main>

<Footer />

</div>

<!-- Auth gate script — decrypts data.enc.json; a successful decrypt IS the auth check.
     The password itself never ships to the browser (contrast the old meta-tag gate). -->
<script>
  import { tryCachedUnlock, unlock } from "../scripts/site-auth";

  const gate    = document.getElementById("site-gate")!;
  const content = document.getElementById("site-content")!;
  const input   = document.getElementById("gate-input") as HTMLInputElement;
  const error   = document.getElementById("gate-error")!;
  const btn     = document.getElementById("gate-submit") as HTMLButtonElement;

  function reveal() {
    gate.style.display = "none";
    content.removeAttribute("style");
    document.documentElement.style.visibility = "";
  }

  function showGate() {
    gate.style.display = "flex";
    document.documentElement.style.visibility = "";
    setTimeout(() => input?.focus(), 50);
  }

  async function tryUnlock() {
    btn.disabled = true;
    const ok = await unlock(input.value);
    btn.disabled = false;
    if (ok) {
      reveal();
    } else {
      error.style.display = "block";
      input.value = "";
      input.focus();
    }
  }

  btn.addEventListener("click", tryUnlock);
  input.addEventListener("keydown", e => {
    if (e.key === "Enter") tryUnlock();
  });

  (async () => {
    if (await tryCachedUnlock()) { reveal(); return; }
    if (await unlock("")) { reveal(); return; } // no site password configured (local dev)
    showGate();
  })();
</script>

<script>
  // Only register SW in production — skip on localhost to avoid stale cache in dev
  if ("serviceWorker" in navigator && location.hostname !== "localhost") {
    navigator.serviceWorker.register("/sw.js").catch(() => {});
  }
</script>

</body>

</html>
