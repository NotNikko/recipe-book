---
interface Props{
title:string;
subtitle?:string;
}

const{
title,
subtitle
}=Astro.props;
---

<section class="space-y-6">

<div>

<h2 class="text-4xl">

{title}

</h2>

{

subtitle &&

<p class="text-[var(--color-text-muted)] mt-2">

{subtitle}

</p>

}

</div>

<slot/>

</section>