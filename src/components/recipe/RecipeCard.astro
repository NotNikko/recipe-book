---
import Card from "../ui/Card.astro";
import Badge from "../ui/Badge.astro";

interface Props {
  id: string;
  title: string;
  description: string;
  image: string;
  category: string;
  difficulty: "Easy" | "Medium" | "Hard";
  prepTime: number;
  servings: number;
  href: string;
}

const { id, title, description, image, category, difficulty, prepTime, servings, href } = Astro.props;
---

<Card>
  <div class="relative">
    <a href={href} class="block">
      <div
        class="relative aspect-[4/3] w-full overflow-hidden rounded-t-3xl"
        style="background: linear-gradient(135deg, var(--color-primary), var(--color-accent))"
      >
        <img
          src={image}
          alt={title}
          class="absolute inset-0 h-full w-full object-cover"
          onerror="this.style.display='none'"
        />
      </div>

      <div class="space-y-3 p-5">
        <h3>{title}</h3>

        <p class="text-sm text-[var(--color-text-muted)]">{description}</p>

        <div class="flex flex-wrap gap-2">
          <Badge>{category}</Badge>
          <Badge color={difficulty === "Easy" ? "green" : difficulty === "Medium" ? "yellow" : "red"}>
            {difficulty}
          </Badge>
        </div>

        <div class="flex justify-between text-sm">
          <span>⏱ {prepTime} min</span>
          <span>🍽 {servings}</span>
        </div>
      </div>
    </a>

    <button
      class="favorite-btn absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-white/80 shadow-sm backdrop-blur-sm transition hover:scale-110"
      data-recipe-id={id}
      aria-label="Toggle favorite"
      aria-pressed="false"
    >
      <span class="heart-icon">🤍</span>
    </button>
  </div>
</Card>

<script>
  const FAVORITES_KEY = "cookbook-favorites";

  function getFavorites(): string[] {
    return JSON.parse(localStorage.getItem(FAVORITES_KEY) ?? "[]");
  }

  function updateHeart(btn: Element, isFav: boolean) {
    const icon = btn.querySelector(".heart-icon");
    if (icon) icon.textContent = isFav ? "❤️" : "🤍";
    btn.setAttribute("aria-pressed", String(isFav));
  }

  const favs = getFavorites();
  document.querySelectorAll<HTMLButtonElement>(".favorite-btn").forEach(btn => {
    const id = btn.dataset.recipeId ?? "";
    updateHeart(btn, favs.includes(id));

    btn.addEventListener("click", () => {
      const current = getFavorites();
      const isFav = current.includes(id);
      const updated = isFav ? current.filter(f => f !== id) : [...current, id];
      localStorage.setItem(FAVORITES_KEY, JSON.stringify(updated));
      updateHeart(btn, !isFav);
    });
  });
</script>
