---
interface Props {
  ingredients: string[];
}

const { ingredients } = Astro.props;
---

<ul class="space-y-3" id="ingredient-list">
  {ingredients.map((ingredient, i) => (
    <li class="ingredient-item flex cursor-pointer items-start gap-3 transition-opacity">
      <button
        class="ingredient-btn mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full border-2 border-[var(--color-border)] transition"
        data-index={i}
        aria-label={`Check off ${ingredient}`}
      ></button>
      <span class="ingredient-text leading-relaxed">{ingredient}</span>
    </li>
  ))}
</ul>

<script>
  document.querySelectorAll<HTMLLIElement>(".ingredient-item").forEach(item => {
    const btn = item.querySelector<HTMLButtonElement>(".ingredient-btn");
    const text = item.querySelector<HTMLSpanElement>(".ingredient-text");
    if (!btn || !text) return;

    btn.addEventListener("click", () => {
      const checked = btn.classList.toggle("checked");
      item.classList.toggle("opacity-40", checked);
      text.classList.toggle("line-through", checked);
    });
  });
</script>

<style>
  .ingredient-btn.checked {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }
  .ingredient-btn.checked::after {
    content: "✓";
    color: white;
    font-size: 11px;
    line-height: 1;
  }
</style>
