---
interface Step {
  text: string;
  timerMinutes: number | null;
}

interface Props {
  title: string;
  instructions: string[];
}

const { title, instructions } = Astro.props;

function extractMinutes(text: string): number | null {
  const m = text.match(/(\d+)(?:\s+to\s+(\d+))?\s+minutes?/i);
  if (!m) return null;
  return m[2] ? parseInt(m[2]) : parseInt(m[1]);
}

const steps: Step[] = instructions.map(text => ({
  text,
  timerMinutes: extractMinutes(text),
}));
---

<button
  id="cooking-mode-trigger"
  class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-5 py-2.5 text-sm font-medium transition hover:bg-[var(--color-bg)] hover:shadow-md"
>
  🍳 Cooking Mode
</button>

<!-- Full-screen overlay -->
<div
  id="cooking-mode-overlay"
  class="fixed inset-0 z-[100] hidden flex-col bg-[var(--color-bg)]"
  style="padding: clamp(1.5rem, 5vw, 3rem)"
>
  <!-- Top bar -->
  <div class="flex items-center justify-between">
    <div>
      <p class="text-sm font-medium text-[var(--color-text-muted)]" id="cm-recipe-title">{title}</p>
      <p class="text-xs text-[var(--color-text-muted)]" id="cm-step-counter"></p>
    </div>
    <button
      id="cm-exit"
      class="rounded-full border border-[var(--color-border)] px-4 py-2 text-sm transition hover:bg-[var(--color-surface)]"
    >
      ✕ Exit
    </button>
  </div>

  <!-- Step content -->
  <div class="flex flex-1 flex-col items-center justify-center gap-8 text-center">
    <p
      class="text-sm font-semibold uppercase tracking-widest text-[var(--color-primary)]"
      id="cm-step-label"
    ></p>

    <p
      id="cm-step-text"
      class="max-w-2xl leading-relaxed"
      style="font-size: clamp(1.25rem, 3vw, 2rem)"
    ></p>

    <!-- Timer (shown only when step has a time) -->
    <div id="cm-timer" class="hidden flex-col items-center gap-3">
      <button
        id="cm-timer-btn"
        class="inline-flex items-center gap-2 rounded-full bg-[var(--color-primary)] px-6 py-3 text-sm font-medium text-white transition hover:bg-[var(--color-primary-hover)]"
      >
        ⏱ <span id="cm-timer-label"></span>
      </button>
      <span id="cm-timer-display" class="hidden text-4xl font-semibold tabular-nums text-[var(--color-primary)]"></span>
    </div>
  </div>

  <!-- Step dots -->
  <div class="flex justify-center gap-2 py-4" id="cm-dots"></div>

  <!-- Navigation -->
  <div class="flex items-center justify-between">
    <button
      id="cm-prev"
      class="rounded-full border border-[var(--color-border)] px-6 py-3 text-sm transition hover:bg-[var(--color-surface)] disabled:opacity-30"
    >
      ← Previous
    </button>
    <button
      id="cm-next"
      class="rounded-full bg-[var(--color-primary)] px-6 py-3 text-sm font-medium text-white transition hover:bg-[var(--color-primary-hover)]"
    >
      Next →
    </button>
  </div>
</div>

<script define:vars={{ steps }}>
  const overlay    = document.getElementById("cooking-mode-overlay");
  const trigger    = document.getElementById("cooking-mode-trigger");
  const exitBtn    = document.getElementById("cm-exit");
  const counter    = document.getElementById("cm-step-counter");
  const stepLabel  = document.getElementById("cm-step-label");
  const stepText   = document.getElementById("cm-step-text");
  const prevBtn    = document.getElementById("cm-prev");
  const nextBtn    = document.getElementById("cm-next");
  const timerWrap  = document.getElementById("cm-timer");
  const timerBtn   = document.getElementById("cm-timer-btn");
  const timerLabel = document.getElementById("cm-timer-label");
  const timerDisp  = document.getElementById("cm-timer-display");
  const dotsWrap   = document.getElementById("cm-dots");

  let current = 0;
  let timerInterval = null;
  let timerRunning = false;
  let wakeLock = null;

  // Build dots
  steps.forEach((_, i) => {
    const dot = document.createElement("div");
    dot.dataset.index = String(i);
    dot.style.cssText = "width:8px;height:8px;border-radius:50%;transition:background .2s;";
    dotsWrap.appendChild(dot);
  });

  function updateDots() {
    Array.from(dotsWrap.children).forEach((dot, i) => {
      dot.style.background = i === current
        ? "var(--color-primary)"
        : "var(--color-border)";
    });
  }

  function clearTimer() {
    if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }
    timerRunning = false;
    timerDisp.classList.add("hidden");
    if (steps[current]?.timerMinutes) {
      timerLabel.textContent = `Set ${steps[current].timerMinutes} min timer`;
    }
  }

  function renderStep() {
    const step = steps[current];
    counter.textContent   = `Step ${current + 1} of ${steps.length}`;
    stepLabel.textContent = `Step ${current + 1}`;
    stepText.textContent  = step.text;
    prevBtn.disabled      = current === 0;
    nextBtn.textContent   = current === steps.length - 1 ? "Finish ✓" : "Next →";

    clearTimer();

    if (step.timerMinutes) {
      timerWrap.style.display = "flex";
      timerLabel.textContent  = `Set ${step.timerMinutes} min timer`;
    } else {
      timerWrap.style.display = "none";
    }

    updateDots();
  }

  function startTimer(minutes) {
    let remaining = minutes * 60;
    timerRunning = true;
    timerLabel.textContent = "Cancel timer";
    timerDisp.classList.remove("hidden");

    const tick = () => {
      const m = Math.floor(remaining / 60);
      const s = remaining % 60;
      timerDisp.textContent = `${m}:${s.toString().padStart(2, "0")}`;
      if (remaining <= 0) {
        clearInterval(timerInterval);
        timerDisp.textContent = "Done! 🎉";
        timerLabel.textContent = `Set ${minutes} min timer`;
        timerRunning = false;
      }
      remaining--;
    };
    tick();
    timerInterval = setInterval(tick, 1000);
  }

  async function open() {
    current = 0;
    overlay.style.display = "flex";
    renderStep();

    if ("wakeLock" in navigator) {
      try { wakeLock = await navigator.wakeLock.request("screen"); } catch {}
    }

    // Prevent body scroll
    document.body.style.overflow = "hidden";
  }

  function close() {
    overlay.style.display = "";
    clearTimer();
    document.body.style.overflow = "";
    if (wakeLock) { wakeLock.release(); wakeLock = null; }
  }

  trigger.addEventListener("click", open);
  exitBtn.addEventListener("click", close);

  prevBtn.addEventListener("click", () => { if (current > 0) { current--; renderStep(); } });
  nextBtn.addEventListener("click", () => {
    if (current < steps.length - 1) { current++; renderStep(); }
    else close();
  });

  timerBtn.addEventListener("click", () => {
    const mins = steps[current].timerMinutes;
    if (!mins) return;
    timerRunning ? clearTimer() : startTimer(mins);
  });

  document.addEventListener("keydown", e => {
    if (overlay.style.display !== "flex") return;
    if (e.key === "ArrowRight" && current < steps.length - 1) { current++; renderStep(); }
    if (e.key === "ArrowLeft"  && current > 0)                { current--; renderStep(); }
    if (e.key === "Escape") close();
  });
</script>
