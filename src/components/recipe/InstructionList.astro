---
interface Props {
  instructions: string[];
}

const { instructions } = Astro.props;
---

<ol class="space-y-8">
  {instructions.map((step, i) => (
    <li class="flex gap-5">
      <span
        class="mt-0.5 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-primary)] text-sm font-semibold text-white"
        aria-label={`Step ${i + 1}`}
      >
        {i + 1}
      </span>
      <p class="leading-relaxed">{step}</p>
    </li>
  ))}
</ol>
