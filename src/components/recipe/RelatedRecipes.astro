---
import RecipeCard from "./RecipeCard.astro";
import Section from "../ui/Section.astro";

interface Recipe {
  id: string;
  title: string;
  description: string;
  image: string;
  category: string;
  difficulty: "Easy" | "Medium" | "Hard";
  prepTime: number;
  servings: number;
  href: string;
}

interface Props {
  recipes: Recipe[];
}

const { recipes } = Astro.props;
---

{recipes.length > 0 && (
  <Section title="You Might Also Like">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {recipes.map(recipe => <RecipeCard {...recipe} />)}
    </div>
  </Section>
)}
