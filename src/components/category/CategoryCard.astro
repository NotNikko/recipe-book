---
interface Props {
  name: string;
  count: number;
  href: string;
  icon?: string;
}

const { name, count, href, icon = "🍴" } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col items-center gap-3 rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-md"
>
  <span class="text-4xl">{icon}</span>
  <div>
    <p class="font-semibold text-[var(--color-text)]">{name}</p>
    <p class="text-sm text-[var(--color-text-muted)]">{count} {count === 1 ? "recipe" : "recipes"}</p>
  </div>
</a>
