---
import CategoryCard from "./CategoryCard.astro";

interface Category {
  name: string;
  count: number;
  href: string;
  icon: string;
}

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
  {categories.map(cat => <CategoryCard {...cat} />)}
</div>
