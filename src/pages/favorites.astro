---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/layout/Container.astro";
---

<BaseLayout title="Favorites — Cookbook">
  <Container>
    <div class="space-y-10 py-16 pb-24">

      <div>
        <h1 class="text-5xl">Favorites</h1>
        <p class="mt-2 text-[var(--color-text-muted)]">Recipes you've saved</p>
      </div>

      <div id="fav-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"></div>

      <p id="fav-empty" class="hidden text-[var(--color-text-muted)]">
        No favorites yet. Tap ❤️ on any recipe to save it here.
      </p>

    </div>
  </Container>
</BaseLayout>

<script>
  import { getData } from "../scripts/site-auth";
  import { getAll, mountCardsGeneric } from "../scripts/user-recipes.ts";

  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  const FAV_KEY = "cookbook-favorites";
  const favs: string[] = JSON.parse(localStorage.getItem(FAV_KEY) ?? "[]");

  getData().then(({ recipes }) => {
    const grid = document.getElementById("fav-grid") as HTMLElement;
    let shown = 0;

    const staticFavs = recipes.filter(r => favs.includes(r.id));
    if (staticFavs.length > 0) {
      mountCardsGeneric(grid, staticFavs, r => `${base}recipes/${r.id}`);
      shown += staticFavs.length;
    }

    const userFavs = getAll().filter(r => favs.includes(r.id));
    if (userFavs.length > 0) {
      mountCardsGeneric(grid, userFavs, r => `${base}recipes/local?id=${r.id}`);
      shown += userFavs.length;
    }

    if (shown === 0) {
      document.getElementById("fav-empty")!.classList.remove("hidden");
    }
  });
</script>
