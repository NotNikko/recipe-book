---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/layout/Container.astro";
---

<BaseLayout title="Recipes — Cookbook">

  <!-- Page header -->
  <div class="py-16">
    <Container>
      <div class="space-y-2">
        <h1 class="text-5xl">Recipes</h1>
        <p id="recipe-count" class="text-[var(--color-text-muted)]"></p>
      </div>
    </Container>
  </div>

  <Container>
    <div class="space-y-10 pb-24">

      <!-- Category filter — populated by script; category names are recipe-derived
           data, so nothing renders here until the site is unlocked. -->
      <div id="category-filter" class="flex flex-wrap gap-2"></div>

      <section class="space-y-6">
        <h2 id="section-title" class="text-4xl"></h2>
        <p id="empty-msg" class="hidden text-[var(--color-text-muted)]">No recipes in this category yet.</p>
        <div id="recipe-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"></div>
        <div id="user-recipe-grid" class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"></div>
      </section>

    </div>
  </Container>

</BaseLayout>

<script>
  import { getData } from "../../scripts/site-auth";
  import { getAll, mountCards, mountCardsGeneric } from "../../scripts/user-recipes.ts";

  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  const activeCategory = new URLSearchParams(window.location.search).get("category") ?? "All";

  getData().then(({ recipes: allRecipes }) => {
    document.getElementById("recipe-count")!.textContent =
      `${allRecipes.length} ${allRecipes.length === 1 ? "recipe" : "recipes"} in your collection`;

    // ── Category filter pills ─────────────────────────────────────────────
    const categories = [...new Set(allRecipes.map(r => r.category))].sort();
    const filterWrap = document.getElementById("category-filter")!;
    ["All", ...categories].forEach(cat => {
      const a = document.createElement("a");
      a.href = cat === "All" ? `${base}recipes` : `${base}recipes?category=${encodeURIComponent(cat)}`;
      a.textContent = cat;
      a.className = `rounded-full px-4 py-2 text-sm transition ${
        activeCategory === cat
          ? "bg-[var(--color-primary)] text-white"
          : "border border-[var(--color-border)] bg-[var(--color-surface)] hover:bg-[var(--color-bg)]"
      }`;
      filterWrap.appendChild(a);
    });

    // ── Filtered recipe grid ────────────────────────────────────────────────
    document.getElementById("section-title")!.textContent =
      activeCategory === "All" ? "All Recipes" : activeCategory;

    const filtered = activeCategory === "All"
      ? allRecipes
      : allRecipes.filter(r => r.category === activeCategory);

    const recipeGrid = document.getElementById("recipe-grid") as HTMLElement;
    if (filtered.length === 0) {
      document.getElementById("empty-msg")!.classList.remove("hidden");
    } else {
      mountCardsGeneric(recipeGrid, filtered, r => `${base}recipes/${r.id}`);
      Array.from(recipeGrid.children).forEach((el, i) => {
        (el as HTMLElement).dataset.staticRecipeId = filtered[i]?.id ?? "";
      });
    }

    // ── Local (user-added) recipes ─────────────────────────────────────────
    const userGrid = document.getElementById("user-recipe-grid") as HTMLElement;
    const all = getAll();
    all.forEach(ur => {
      const el = document.querySelector<HTMLElement>(`[data-static-recipe-id="${ur.id}"]`);
      if (el) el.style.display = "none";
    });
    const localFiltered = activeCategory === "All" ? all : all.filter(r => r.category === activeCategory);
    mountCards(userGrid, localFiltered);
  });
</script>
